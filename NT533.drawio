  <diagram name="02 - DR Workflow" id="1">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="NT533 | Luồng phục hồi Disaster Recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;fontSize=27;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="30" width="1150" height="45" />
        </mxCell>
        <mxCell id="s" value="Singapore điều phối phục hồi • AWS service icons được nhúng trực tiếp vào file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;fontSize=15;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="85" width="1150" height="30" />
        </mxCell>
        <mxCell id="step0" value="&lt;b&gt;1. CloudWatch Alarm&lt;/b&gt;&lt;br&gt;Bất kỳ target group nào thiếu healthy host: 3/5 phút. Composite alarm dùng OR." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;spacingLeft=90;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="170" y="140" width="920" height="90" />
        </mxCell>
        <mxCell id="ico0" value="" style="shape=stencil();fillColor=#E7157B;strokeColor=none;html=1;whiteSpace=wrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=13;fontColor=#172B4D;spacingTop=7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="158" width="52" height="52" />
        </mxCell>
        <mxCell id="step1" value="&lt;b&gt;2. EventBridge → Step Functions&lt;/b&gt;&lt;br&gt;Forward event từ Sydney; DR bus bắt ALARM và khởi chạy state machine." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;spacingLeft=90;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="170" y="255" width="920" height="90" />
        </mxCell>
        <mxCell id="ico1" value="" style="shape=stencil();fillColor=#E7157B;strokeColor=none;html=1;whiteSpace=wrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=13;fontColor=#172B4D;spacingTop=7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="273" width="52" height="52" />
        </mxCell>
        <mxCell id="seq1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontColor=#64748B;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="step0" target="step1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step2" value="&lt;b&gt;3. Xác nhận sự cố + singleton lock&lt;/b&gt;&lt;br&gt;Đợi 90 giây, Lambda kiểm tra primary; chiếm DynamoDB lock để tránh restore trùng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;spacingLeft=90;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="170" y="370" width="920" height="90" />
        </mxCell>
        <mxCell id="ico2" value="" style="shape=stencil();fillColor=#C925D1;strokeColor=none;html=1;whiteSpace=wrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=13;fontColor=#172B4D;spacingTop=7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="388" width="52" height="52" />
        </mxCell>
        <mxCell id="seq2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontColor=#64748B;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step3" value="&lt;b&gt;4. Tạo hạ tầng DR&lt;/b&gt;&lt;br&gt;CloudFormation tạo VPC, NAT, ALB, ECS services với desiredCount=0; templates từ S3." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;spacingLeft=90;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="170" y="485" width="920" height="90" />
        </mxCell>
        <mxCell id="ico3" value="" style="shape=stencil();fillColor=#E7157B;strokeColor=none;html=1;whiteSpace=wrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=13;fontColor=#172B4D;spacingTop=7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="503" width="52" height="52" />
        </mxCell>
        <mxCell id="seq3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontColor=#64748B;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step4" value="&lt;b&gt;5. Khôi phục database&lt;/b&gt;&lt;br&gt;Lambda chọn recovery point mới nhất; AWS Backup restore RDS; đợi COMPLETED và available." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;spacingLeft=90;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="170" y="600" width="920" height="90" />
        </mxCell>
        <mxCell id="ico4" value="" style="shape=stencil();fillColor=#7AA116;strokeColor=none;html=1;whiteSpace=wrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=13;fontColor=#172B4D;spacingTop=7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="618" width="52" height="52" />
        </mxCell>
        <mxCell id="seq4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontColor=#64748B;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step5" value="&lt;b&gt;6. Cập nhật DR runtime secret&lt;/b&gt;&lt;br&gt;Lambda ghép credentials replica với endpoint RDS vừa restore: host, port, username, password, dbname." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;spacingLeft=90;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="170" y="715" width="920" height="90" />
        </mxCell>
        <mxCell id="ico5" value="" style="shape=stencil();fillColor=#DD344C;strokeColor=none;html=1;whiteSpace=wrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=13;fontColor=#172B4D;spacingTop=7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="733" width="52" height="52" />
        </mxCell>
        <mxCell id="seq5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontColor=#64748B;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step6" value="&lt;b&gt;7. Khởi chạy ứng dụng&lt;/b&gt;&lt;br&gt;Step Functions scale 3 ECS Fargate services lên ProductionDesiredCount; lấy image ECR Singapore." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;spacingLeft=90;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="170" y="830" width="920" height="90" />
        </mxCell>
        <mxCell id="ico6" value="" style="shape=stencil();fillColor=#ED7100;strokeColor=none;html=1;whiteSpace=wrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=13;fontColor=#172B4D;spacingTop=7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="848" width="52" height="52" />
        </mxCell>
        <mxCell id="seq6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontColor=#64748B;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="step5" target="step6">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step7" value="&lt;b&gt;8. Kiểm tra sức khỏe DR&lt;/b&gt;&lt;br&gt;Lambda kiểm tra đủ healthy targets ở cả 3 target groups; ứng dụng /health kiểm tra DB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;spacingLeft=90;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="170" y="945" width="920" height="90" />
        </mxCell>
        <mxCell id="ico7" value="" style="shape=stencil();fillColor=#ED7100;strokeColor=none;html=1;whiteSpace=wrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=13;fontColor=#172B4D;spacingTop=7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="963" width="52" height="52" />
        </mxCell>
        <mxCell id="seq7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontColor=#64748B;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="step6" target="step7">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="step8" value="&lt;b&gt;9. Kiểm tra primary lần cuối&lt;/b&gt;&lt;br&gt;Nếu primary phục hồi: bỏ cutover, gửi thông báo và giải phóng lock." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;spacingLeft=90;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="170" y="1060" width="920" height="90" />
        </mxCell>
        <mxCell id="ico8" value="" style="shape=stencil();fillColor=#E7157B;strokeColor=none;html=1;whiteSpace=wrap;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=13;fontColor=#172B4D;spacingTop=7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="190" y="1078" width="52" height="52" />
        </mxCell>
        <mxCell id="seq8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontColor=#64748B;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="step7" target="step8">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="choice" value="skip_route53_switch = true ?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DE;strokeColor=#ED7100;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="1190" width="380" height="60" />
        </mxCell>
        <mxCell id="check" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748B;fontColor=#64748B;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="step8" target="choice">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="safe" value="SAFE TEST / ALARM DEFAULT&lt;br&gt;Giữ DNS hiện tại; kiểm thử trực tiếp DR ALB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1300" width="500" height="75" />
        </mxCell>
        <mxCell id="cut" value="DNS CUTOVER (khi được bật)&lt;br&gt;UPSERT SECONDARY alias → DR ALB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16803C;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="710" y="1300" width="500" height="75" />
        </mxCell>
        <mxCell id="yes" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563EB;fontColor=#2563EB;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="choice" target="safe">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="no" value="false" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16803C;fontColor=#16803C;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="choice" target="cut">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="end" value="Kết thúc: SNS thông báo + giải phóng DynamoDB lock. Nhánh lỗi: SNS báo thất bại + giải phóng lock.&#xa;Chi tiết bám theo stepfunctions.yaml, eventbridge-dr.yaml, monitoring.yaml; ưu tiên code khi README khác." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#172B4D;fontSize=15;verticalAlign=top;align=left;spacing=14;fontSize=14;spacing=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="1410" width="1100" height="60" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
